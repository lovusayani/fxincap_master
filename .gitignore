# =============================================================================
# FXIncap monorepo .gitignore
#
# Do NOT add: ecosystem*.cjs, deploy/, deploy-prod.sh, install-prod.sh,
# run-prod.sh, *.example, migrations/*.sql, fxincapws/sql/*.sql
# Production depends on those being tracked. See docs/REPOSITORY_STRUCTURE.md §4.
# =============================================================================

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
pm2-logs/
.pm2/
pids/
*.pid
*.pid.lock
*.seed

# Env and secrets
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.production.local
.env.development.local
.env.test.local
.deploy.env
*.pem
*.key
*.crt
*.p12
*.pfx
# Managed-database TLS bundle (named explicitly as well as by *.crt)
ca-certificate.crt

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*
.pnpm-store/
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
coverage/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
dist/spa/
dist/server/

# Tool caches
.eslintcache
.prettiercache

# Temp/work files
.tmp*/
tmp/
*.tmp
*.tar.gz
*.zip
staging-release/
*.bak
*.orig
*.rej
*~

# Runtime uploads/cache
# NOTE: user KYC documents and deposit screenshots land here. They must never be
# committed — see docs/SECURITY.md §7 for why this matters.
uploads/**
!uploads/.gitkeep
fxincapapi/uploads/**
!fxincapapi/uploads/.gitkeep
fxincaptrade/uploads/**
!fxincaptrade/uploads/.gitkeep

# Local test helpers
test-order.mjs
fxincapapi/test-fixes.mjs
fxincapapi/test-order.mjs
fxincapapi/test-trade.mjs

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Scratch credential file - an Infoway API key was committed here (see SECURITY.md)
imp
