# .env.example - Copy to .env and fill with your values

# Database Configuration (fxincapapi uses PG*; see src/lib/database.ts)
# REQUIRED — there is no source-code fallback. The service refuses to start
# without these, so it can never silently connect to the wrong cluster.
PGHOST=YOUR_DB_HOST
PGPORT=25060
PGUSER=YOUR_DB_USER
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=YOUR_DB_NAME
PGSSLMODE=require
# Local Windows: leave false or omit. Set true only with a valid PGSSL_CA bundle.
PGSSL_REJECT_UNAUTHORIZED=false

# Legacy names (some tools still use these)
DB_HOST=YOUR_DB_HOST
DB_PORT=25060
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME

# Server Configuration
PORT=6000
NODE_ENV=development

# Authentication — REQUIRED. The service refuses to start without it.
# There is no longer a source-code fallback. Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET

# Internal service token — REQUIRED. Guards the trade maintenance endpoints
# (/api/trades/price-update, /api/trades/admin/*) that mutate financial state.
# Presented as the `x-internal-token` header. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN

# CORS (comma-separated). Trade UI uses VITE_API_URL → browser Origin is the trade host, not the API.
# Include: production trade + admin + local dev origins if you lock CORS down.
# Leave empty to allow any origin (default when unset).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://trade.ncapfx.com,https://admin.ncapfx.com

# Payment Gateway
OXAPAY_API_KEY=your-api-key
OXAPAY_WEBHOOK_SECRET=your-secret

# MetaAPI
METAAPI_TOKEN=your-token
METAAPI_ACCOUNT_ID=your-account-id

# Trade background workers (auto-close, price sync, SL/TP).
# These close real positions and rewrite real balances.
# Default: ON in production, OFF everywhere else (src/lib/env.ts).
# Never set true on a dev machine pointed at the production database - it would
# settle live trades in parallel with the real server. See docs/SECURITY.md.
ENABLE_TRADE_WORKERS=false

# WebSocket / quotes (SL/TP auto-close polls fxincapws HTTP: GET /quote/:symbol)
WS_QUOTE_BASE_URL=http://127.0.0.1:4040
SL_TP_POLL_MS=4000
WEBSOCKET_PORT=6020

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.ncapfx.com
MAILGUN_FROM=noreply@ncapfx.com
MAILGUN_REGION=us
VERIFICATION_URL=https://admin.ncapfx.com/deposits

# Admin
ADMIN_EMAIL=admin@ncapfx.com
ADMIN_PASSWORD=change-this
