# fxincap-ws — copy to .env and fill in.
#
# Every variable marked REQUIRED is validated at boot. The service refuses to
# start if one is missing: these previously had insecure defaults in source
# (a hard-coded production database host and a shared 'changeme' admin token).
# See docs/ENVIRONMENT.md §5 and docs/SECURITY.md §3.

# HTTP + WebSocket port
WS_PORT=4040

# REQUIRED — admin API token. Must equal WS_ADMIN_TOKEN on the admin server.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=YOUR_WS_ADMIN_TOKEN

# REQUIRED — same PostgreSQL database as fxincapapi.
# DB_HOST / DB_USER / DB_PASSWORD / DB_NAME are accepted as aliases.
PGHOST=YOUR_DB_HOST
PGPORT=25060
PGUSER=YOUR_DB_USER
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=YOUR_DB_NAME
PGSSLMODE=require

# Optional — seeds the finnhub row on first boot only. Provider API keys are
# managed in the ws_api_keys table via Admin -> Server Settings, not here.
FINNHUB_API_KEY=

# Optional — when empty, /webhook/finnhub signature verification is SKIPPED.
# Set it if that webhook is in use.
FINNHUB_WEBHOOK_SECRET=
