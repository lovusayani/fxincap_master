# fxincap-ws — copy to .env and fill in.
#
# Every variable marked REQUIRED is validated at boot. The service refuses to
# start if one is missing: these previously had insecure defaults in source
# (a hard-coded production database host and a shared 'changeme' admin token).
# See docs/ENVIRONMENT.md §5 and docs/SECURITY.md §3.

# HTTP + WebSocket port
WS_PORT=4040

# REQUIRED — admin API token. Must equal WS_ADMIN_TOKEN on the admin server.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=YOUR_WS_ADMIN_TOKEN

# REQUIRED — same PostgreSQL database as fxincapapi.
# DB_HOST / DB_USER / DB_PASSWORD / DB_NAME are accepted as aliases.
PGHOST=YOUR_DB_HOST
PGPORT=25060
PGUSER=YOUR_DB_USER
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=YOUR_DB_NAME
PGSSLMODE=require

# Optional — seeds the finnhub row on first boot only. Provider API keys are
# managed in the ws_api_keys table via Admin -> Server Settings, not here.
FINNHUB_API_KEY=

# Optional — when empty, /webhook/finnhub signature verification is SKIPPED.
# Set it if that webhook is in use.
FINNHUB_WEBHOOK_SECRET=

# --- Infoway (https://docs.infoway.io) --------------------------------------
# The API key is normally stored in ws_api_keys and managed from
# Admin -> Server Settings. INFOWAY_API_KEY is a local-development fallback
# used when that row is empty. NEVER commit a real key.
INFOWAY_API_KEY=

# Endpoint overrides. Defaults match the documented public endpoints.
INFOWAY_REST_URL=https://data.infoway.io
INFOWAY_WS_URL=wss://data.infoway.io/ws

# Optional symbol overrides, comma separated, CLIENT=PROVIDER.
# Only needed if Infoway's forex/metal codes differ from this platform's
# (defaults to pass-through, e.g. XAUUSD -> XAUUSD).
#   INFOWAY_SYMBOL_MAP=XAUUSD=XAU/USD,EURUSD=EUR/USD
INFOWAY_SYMBOL_MAP=

# Reconnect tuning (optional)
INFOWAY_MAX_RECONNECT_ATTEMPTS=5
INFOWAY_RECONNECT_BASE_MS=3000
